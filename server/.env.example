DATABASE_URL=postgresql://metabolic:metabolic_password@localhost:5433/metabolic
PORT=8080
NODE_ENV=development
FIREBASE_PROJECT_ID=metabolic-v1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=metabolic-v1.firebasestorage.app
AI_PROVIDER=mock
# SMS routing: tree = regex/commands (legacy), agent = Gemini tool-calling (production default).
SMS_AGENT_MODE=tree
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use the sms: prefix to send/receive over SMS+MMS (required for iMessage photos).
# The number must be MMS-enabled in the Twilio console to receive meal photos.
TWILIO_PHONE_NUMBER=sms:+13853634403
# Set to true to enforce X-Twilio-Signature validation on the inbound webhook.
TWILIO_VALIDATE_SIGNATURE=false
# Optional: the exact public webhook URL Twilio posts to (used for signature validation behind a proxy).
TWILIO_WEBHOOK_URL=
# Outbound email (welcome, Message Center, store/feedback alerts). Verify the from domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DoNotReply@MasterMetabolic.com
RESEND_FROM_NAME=Master Metabolic
# Optional fallbacks if RESEND_FROM_* are unset:
# SENDGRID_FROM_EMAIL=DoNotReply@MasterMetabolic.com
# SENDGRID_FROM_NAME=Master Metabolic
CLIENT_URL=http://localhost:5173
# Public API base for Message Center asset URLs (Cloud Run URL in production — not CLIENT_URL).
# Defaults to http://localhost:$PORT when unset.
API_PUBLIC_URL=
# Signed unsubscribe tokens for optional Message Center emails (required in production).
UNSUBSCRIBE_TOKEN_SECRET=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Shared secret for the proactive SMS reminder scheduler (Cloud Scheduler -> /api/internal/sms/tick).
CRON_SECRET=
# Apple IAP (StoreKit 2 / App Store Server Notifications V2). Root CAs are vendored.
# Create an In-App Purchase key in App Store Connect → Users and Access → Integrations
# if you want optional Get Transaction Info lookups later. JWS verification works
# without the key; the webhook still needs this API deployed at:
#   POST /api/billing/apple/notifications
APPLE_BUNDLE_ID=com.mastermetabolic.app
APPLE_APP_APPLE_ID=6810053439
# Sandbox | Production | auto (try Production, then Sandbox)
APPLE_IAP_ENVIRONMENT=auto
# OCSP revocation checks against Apple PKI. Enable in production when egress allows it.
APPLE_IAP_ENABLE_ONLINE_CHECKS=false
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
# Google Play Billing for the two digital plans. Do not commit a service-account JSON or key.
# Email and private key are unknown until Derek creates the Play Console service account.
# The key needs Play Console permission "Manage orders and subscriptions" (see docs/google-play-billing.md).
GOOGLE_PLAY_PACKAGE_NAME=com.mastermetabolic.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# Pub/Sub push OIDC audience. Unknown until the RTDN push subscription exists.
# When set, POST /api/billing/google/rtdn requires a matching bearer token.
GOOGLE_PLAY_RTDN_AUDIENCE=
