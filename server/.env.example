DATABASE_URL=postgresql://metabolic:metabolic_password@localhost:5433/metabolic
PORT=8080
NODE_ENV=development
FIREBASE_PROJECT_ID=metabolic-v1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=metabolic-v1.firebasestorage.app
AI_PROVIDER=mock
# SMS routing: tree = regex/commands (legacy), agent = Gemini tool-calling (production default).
SMS_AGENT_MODE=tree
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use the sms: prefix to send/receive over SMS+MMS (required for iMessage photos).
# The number must be MMS-enabled in the Twilio console to receive meal photos.
TWILIO_PHONE_NUMBER=sms:+13853634403
# Set to true to enforce X-Twilio-Signature validation on the inbound webhook.
TWILIO_VALIDATE_SIGNATURE=false
# Optional: the exact public webhook URL Twilio posts to (used for signature validation behind a proxy).
TWILIO_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=DoNotReply@MasterMetabolic.com
SENDGRID_FROM_NAME=Master Metabolic
CLIENT_URL=http://localhost:5173
# Shared secret for the proactive SMS reminder scheduler (Cloud Scheduler -> /api/internal/sms/tick).
CRON_SECRET=
