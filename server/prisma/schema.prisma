}

/// The plan in effect for a program from `effectiveDate` until the next PlanPeriod.
/// "Week" = period-to-period; resolveTemplateForDate reads the latest one on/before a date,
/// falling back to the Program defaults so programs with no PlanPeriod behave exactly as before.
model PlanPeriod {
  id String @id @default(cuid())
  programId String
  effectiveDate DateTime
  weekNumber Int?
  /// Frozen weekly targets (formula era). Null on legacy periods, which resolve
  /// their targets through nutritionTemplateId instead.
  calorieTarget Decimal? @db.Decimal(10, 2)
  proteinTarget Decimal? @db.Decimal(10, 2)
  carbTarget Decimal? @db.Decimal(10, 2)
  fatTarget Decimal? @db.Decimal(10, 2)
  targetSource TargetSource?
  nutritionTemplateId String?
  exerciseTemplateId String?
  coachSessionId String? @unique
  sourceSnapshotId String?
  notes String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  nutritionTemplate NutritionPlanTemplate? @relation(fields: [nutritionTemplateId], references: [id], onDelete: SetNull)
  exerciseTemplate ExerciseTemplate? @relation(fields: [exerciseTemplateId], references: [id], onDelete: SetNull)
  coachSession CoachSession? @relation(fields: [coachSessionId], references: [id], onDelete: SetNull)
  sourceSnapshot ProgramMetricSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  createdBy User? @relation("PlanPeriodCreator", fields: [createdById], references: [id], onDelete: SetNull)
  @@unique([programId, effectiveDate])
  @@index([programId, effectiveDate])
}

