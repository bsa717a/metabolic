  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StoreOrderItem[]
  @@index([userId, status])
}

model StoreOrderItem {
  id String @id @default(cuid())
  orderId String
  productId String?
  /// Name and price frozen at checkout time so later catalog edits never rewrite history.
  nameSnapshot String
  priceCentsSnapshot Int
  quantity Int
  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

enum FeedbackType {
  BUG
  CONFUSING
  IDEA
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  RESOLVED
  CLOSED
  DUPLICATE
  CANNOT_REPRODUCE
}

enum FeedbackSeverity {
  BLOCKING
  HIGH
  MEDIUM
  LOW
}

model FeedbackReport {
  id String @id @default(cuid())
  /// Human-friendly reference is derived as "FB-${seq}".
  seq Int @unique @default(autoincrement())
  type FeedbackType
  status FeedbackStatus @default(NEW)
  blocking Boolean @default(false)
  severity FeedbackSeverity?
  /// Tester answers.
  goal String
  detail String
  /// Reporter snapshot (survives user deletion).
  userId String?
  reporterEmail String
  reporterName String
  accountType String
  /// Where the report came from: "in_app" (feedback widget) or "public_support_page".
  source String @default("in_app")
  /// Public-support issue category (null for in-app widget reports).
  category String?
  /// Safe context.
  route String
  screenLabel String?
  appVersion String?
  /// Whitelisted diagnostics blob (see sanitizeDiagnostics); nulled on retention purge.
  diagnostics Json?
  diagnosticsPurgedAt DateTime?
  /// Workflow.
  assignedToId String?
  resolutionNote String?
  externalRef String?
  duplicateOfId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation("FeedbackReporter", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("FeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  duplicateOf FeedbackReport? @relation("FeedbackDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates FeedbackReport[] @relation("FeedbackDuplicate")
  notes FeedbackNote[]
  events FeedbackEvent[]
  @@index([status, createdAt])
  @@index([type, blocking])
}

model FeedbackNote {
  id String @id @default(cuid())
  reportId String
  authorId String?
  body String
  createdAt DateTime @default(now())
  report FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  @@index([reportId])
}

model FeedbackEvent {
  id String @id @default(cuid())
  reportId String
  actorId String?
  kind String
  detail Json?
  createdAt DateTime @default(now())
  report FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([reportId])
}

/// Admin Message Center draft/sent email (Unlayer HTML + design JSON).
model Communication {
  id String @id @default(cuid())
  subject String?
  body String
  bodyDesign Json?
  channel String @default("email")
  category String
  status String @default("draft")
  recipientsJson Json?
  sentAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String
  creator User @relation("CommunicationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User @relation("CommunicationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  recipients CommunicationRecipient[]
  @@index([status])
  @@index([deletedAt])
  @@index([createdBy])
}

model CommunicationRecipient {
  id String @id @default(cuid())
  communicationId String
  userId String?
  displayName String?
  email String?
  phone String?
  channel String
  status String @default("pending")
  skipReason String?
  errorMessage String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([communicationId])
  @@index([status])
  @@index([userId])
}

model CommunicationTemplate {
  id String @id @default(cuid())
  name String
  subject String?
  body String
  bodyDesign Json?
  channel String @default("email")
  category String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String
  creator User @relation("CommunicationTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User @relation("CommunicationTemplateUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  @@index([deletedAt])
}

model CommunicationUnsubscribe {
  id String @id @default(cuid())
  userId String?
  email String?
  phone String?
  channel String
  category String?
  token String?
  source String
  unsubscribedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([email, phone, channel, category])
}
